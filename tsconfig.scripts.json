{
  // Type-checks the pipeline's shared modules and small CLIs (plain JS + JSDoc) against
  // src/lib/data-types.ts. Run by `npm run typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": { "checkJs": true, "noEmit": true, "incremental": false, "types": ["node"] },
  "include": [
    "scripts/lib/*.js",
    "scripts/import-product.js",
    "scripts/validate-data.js",
    "scripts/check-page-size.js",
    "scripts/drop-reviews.js",
    "scripts/drop-thin-products.js",
    "scripts/drop-unscored.js",
    "scripts/score-reviews.js",
    "scripts/refresh.js",
    "scripts/sync-claude-skills.js",
    "src/lib/data-types.ts"
  ]
}
