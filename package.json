{
  "name": "tech-scorecard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/validate-data.js",
    "postbuild": "node scripts/check-page-size.js",
    "validate": "node scripts/validate-data.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "next lint --dir src --dir scripts --dir test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "next": "^15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
